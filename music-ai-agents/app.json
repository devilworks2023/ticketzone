{
  "expo": {
    "name": "MusicLab AI",
    "slug": "musiclab-ai-agents",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "musiclab-ai",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.musiclab.ai"
    },
    "android": {
      "package": "app.musiclab.ai"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
